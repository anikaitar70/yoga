# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Docker / SSL runtime data
/certbot/
/backups/

# User uploads — persist on VPS only, not in git
/public/uploads/**
!/public/uploads/**/.gitkeep

# OS / editor
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Logs
*.log
logs/

# Local AI assistant documentation — never commit
docs/LLM_PROJECT_DOCUMENTATION.md
docs/ARCHITECTURE_DIAGRAM.md
docs/PROJECT_MEMORY.md
CLAUDE.md
cursor.md
CURSOR.md
PROJECT.md
ARCHITECTURE.md
architecture.md
developer.md
DEVELOPER.md
contributing-ai.md
.cursor/llm-docs/
**/LLM_PROJECT_DOCUMENTATION.md
**/ARCHITECTURE_DIAGRAM.md
