generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventCategory {
  YOGA
  HEALING
  JUST_ART_LIFE
  RETREATS_AND_TOURS
  RETREAT
  WORKSHOP
  TEACHER_TRAINING
  PHILOSOPHY
  YOGA_NIDRA
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TestimonialSourceType {
  TEXT
  IMAGE
  OCR
}

enum TestimonialDisplayStyle {
  CARD
  HANDWRITTEN
}

enum PageType {
  YOGA
  HEALING
  JUST_ART_LIFE
  ABOUT
}

enum PageSectionType {
  HERO
  IMAGE_TEXT
  GALLERY
  TESTIMONIALS
  EVENTS
  CONTACT
  CUSTOM_TEXT
  DYNAMIC_IMAGE_TEXT
  BUTTON
}

enum SpecialEventTocMode {
  AUTOMATIC
  CUSTOM
}

enum PreferredContactMethod {
  WHATSAPP
  CALL
  SMS
  EMAIL
  LINE
  TELEGRAM
  OTHER
}

enum GalleryCategory {
  ART
  YOGA_NIDRA
  EVENTS
  RETREATS
  HEALING
  JAPAN_EVENTS
}

enum CollageLayout {
  MASONRY
  STACKED
  ASYMMETRICAL_GRID
  HERO_SUPPORTING
  HORIZONTAL_STRIP
  FEATURED_SUPPORTING
}

enum HeroMediaMode {
  SINGLE
  ROTATING
  COLLAGE
  FEATURED_COLLECTION
}

enum TranslationReviewStatus {
  MACHINE
  HUMAN_REVIEWED
}

model User {
  id        String      @id @default(uuid())
  email     String      @unique
  name      String?
  avatarUrl String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  blogPosts BlogPost[]
  events    Event[]
}

model Event {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  location    String
  startsAt    DateTime
  endsAt      DateTime?
  imageUrl    String?
  imageAlt    String?
  /// Public card click target (HTTPS URL to the hosted event page).
  externalUrl String?
  /// CMS Read More panel JSON. See src/lib/event-detail.ts
  eventDetail Json?
  /// Label for the external-link button on the public event card.
  externalLinkLabel String?
  /// Primary CTA label on the dedicated special event public page.
  specialEventCtaLabel String?
  /// Primary CTA destination on the dedicated special event page (HTTPS or internal path).
  specialEventCtaUrl String?
  sortOrder   Int      @default(0)
  price       Float?
  category    EventCategory @default(YOGA)
  isFeatured  Boolean  @default(false)
  published   Boolean  @default(true)
  seoTitle              String?
  metaDescription       String?
  ogImageUrl            String?
  canonicalUrlOverride  String?
  focusKeywords         String[] @default([])
  jaTranslationStatus   TranslationReviewStatus @default(MACHINE)
  /// Japanese card copy when provided. Shape: { title?, description?, location?, externalLinkLabel? }
  jaLocale              Json?
  /// When true, event may have a dedicated public page at /events/special/[slug].
  isSpecialEvent        Boolean              @default(false)
  specialEventTocMode   SpecialEventTocMode  @default(AUTOMATIC)
  /// Custom TOC entries when specialEventTocMode is CUSTOM. See src/lib/event-page-section.ts
  specialEventTocOverride Json?
  pageSections          EventPageSection[]
  specialEventTestimonials SpecialEventTestimonial[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User?  @relation(fields: [authorId], references: [id])
  authorId String?
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  summary     String
  content     String
  sections    Json?
  coverImageUrl String?
  coverImageAlt String?
  tags        String[] @default([])
  published   Boolean  @default(false)
  publishedAt DateTime @default(now())
  seoTitle              String?
  metaDescription       String?
  ogImageUrl            String?
  canonicalUrlOverride  String?
  focusKeywords         String[] @default([])
  jaTranslationStatus   TranslationReviewStatus @default(MACHINE)
  /// Japanese CMS copy when jaTranslationStatus is HUMAN_REVIEWED. Shape: { title?, summary?, content?, sections? }
  jaLocale              Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User?  @relation(fields: [authorId], references: [id])
  authorId String?
}

model PageSeo {
  id                    String   @id @default(uuid())
  path                  String   @unique
  seoTitle              String?
  metaDescription       String?
  ogImageUrl            String?
  canonicalUrlOverride  String?
  focusKeywords         String[] @default([])
  jaTranslationStatus   TranslationReviewStatus @default(MACHINE)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  subscribedAt DateTime @default(now())
}

model GalleryCollection {
  id          String          @id @default(uuid())
  slug        String          @unique
  title       String
  description String?
  category    GalleryCategory
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  images   GalleryImage[]
  collages GalleryCollage[]

  @@index([category, sortOrder])
}

model GalleryImage {
  id                 String          @id @default(uuid())
  title              String?
  url                String
  thumbnailUrl       String?
  mediumUrl          String?
  width              Int?
  height             Int?
  uploadPath         String?
  altText            String?
  description        String?
  category           GalleryCategory @default(ART)
  collectionId       String?
  collection         GalleryCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  sourceKey          String?         @unique
  sortOrder          Int             @default(0)
  featuredOnHomepage Boolean         @default(false)
  isPublished        Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([category, isPublished])
  @@index([collectionId, sortOrder])
}

model GalleryCollage {
  id           String          @id @default(uuid())
  name         String
  slug         String          @unique
  layout       CollageLayout   @default(MASONRY)
  category     GalleryCategory
  collectionId String?
  collection   GalleryCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  imageIds     Json            @default("[]")
  isPublished  Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  heroSections HeroSection[]

  @@index([category, isPublished])
  @@index([collectionId])
}

model ContactMessage {
  id                     String                  @id @default(uuid())
  name                   String
  email                  String
  subject                String
  message                String
  preferredContactMethod PreferredContactMethod?
  createdAt              DateTime                @default(now())
}

model PageSection {
  id          String          @id @default(uuid())
  pageType    PageType
  sectionType PageSectionType
  title       String?
  subtitle    String?
  content     String?         @db.Text
  imageUrl    String?
  imageAlt    String?
  sortOrder   Int             @default(0)
  isPublished Boolean         @default(true)
  layout      Json?
  payload     Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([pageType, sortOrder])
}

model EventPageSection {
  id          String          @id @default(uuid())
  eventId     String
  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sectionType PageSectionType
  /// Stable anchor for TOC links — does not change when the section title is edited.
  anchorSlug  String
  title       String?
  subtitle    String?
  content     String?         @db.Text
  imageUrl    String?
  imageAlt    String?
  sortOrder   Int             @default(0)
  isPublished Boolean         @default(true)
  layout      Json?
  payload     Json?
  /// Japanese section copy when provided. Shape matches LocalePageSectionPatch.
  jaLocale    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([eventId, anchorSlug])
  @@index([eventId, sortOrder])
}

model SiteConfig {
  id             String   @id @default(uuid())
  name           String
  tagline        String
  contactEmail   String
  contactPhone   String
  contactAddress String
  social         Json
  branding       Json?
  navigation     Json?
  homepageLayout   Json?
  homepageSections Json?
  timelineStyleDefaults Json?
  timelineStyleByPage   Json?
  designSettings        Json?
  designSettingsByPage  Json?
  localeContent         Json?
  /// Main /events page display settings. See src/lib/events-page-settings.ts
  eventsPageSettings    Json?
  /// Testimonials page display settings. See src/lib/testimonials-page-settings.ts
  testimonialsPageSettings Json?
  createdAt        DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HeroSection {
  id                    String          @id @default(uuid())
  title                 String
  subtitle              String
  primaryCtaLabel       String
  primaryCtaHref        String
  secondaryCtaLabel     String
  secondaryCtaHref      String
  imageSrc              String
  imageAlt              String
  mediaMode             HeroMediaMode   @default(SINGLE)
  rotatingImages        Json?
  collageId             String?
  collage               GalleryCollage? @relation(fields: [collageId], references: [id], onDelete: SetNull)
  featuredCollectionId  String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model AboutPage {
  id         String   @id @default(uuid())
  eyebrow    String
  title      String
  subtitle   String
  imageSrc   String
  imageAlt   String
  paragraphs String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Testimonial {
  id             String                   @id @default(uuid())
  quote          String                   @default("")
  name           String                   @default("")
  role           String                   @default("")
  city           String?
  country        String?
  imageUrl       String?
  imageAlt       String?
  extractedText  String?                  @db.Text
  sourceType     TestimonialSourceType    @default(TEXT)
  displayStyle   TestimonialDisplayStyle  @default(HANDWRITTEN)
  ocrConfidence  Float?
  featured       Boolean                  @default(false)
  sortOrder      Int                      @default(0)
  status         TestimonialStatus        @default(APPROVED)
  /// Japanese copy when provided. Shape: { quote?, name?, role?, city?, country? }
  jaLocale       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  homepageSelections     HomepageTestimonial[]     @relation("HomepageTestimonials")
  programPageSelections  ProgramPageTestimonial[]  @relation("ProgramPageTestimonials")
  specialEventSelections SpecialEventTestimonial[] @relation("SpecialEventTestimonials")

  @@index([status, featured, sortOrder])
}

model HomepageTestimonial {
  id            String      @id @default(cuid())
  testimonialId String      @unique
  testimonial   Testimonial @relation("HomepageTestimonials", fields: [testimonialId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([sortOrder])
}

model ProgramPageTestimonial {
  id            String      @id @default(cuid())
  pageType      PageType
  testimonialId String
  testimonial   Testimonial @relation("ProgramPageTestimonials", fields: [testimonialId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([pageType, testimonialId])
  @@index([pageType, sortOrder])
}

model SpecialEventTestimonial {
  id            String      @id @default(cuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  testimonialId String
  testimonial   Testimonial @relation("SpecialEventTestimonials", fields: [testimonialId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([eventId, testimonialId])
  @@index([eventId, sortOrder])
}

model PageView {
  id        String   @id @default(uuid())
  path      String
  visitorId String
  viewedAt  DateTime @default(now())

  @@index([viewedAt])
  @@index([path, viewedAt])
  @@index([visitorId, viewedAt])
}

enum DiagnosticCategory {
  UPLOAD_FAILURE
  LOGIN_FAILURE
  CMS_SAVE_FAILURE
  IMAGE_PROCESSING_FAILURE
}

model AppDiagnosticEvent {
  id        String             @id @default(uuid())
  category  DiagnosticCategory
  message   String
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([category, createdAt])
}

model AdminSession {
  id         String    @id @default(cuid())
  email      String
  ipAddress  String
  userAgent  String?
  loginAt    DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([email, revokedAt])
  @@index([lastSeenAt])
  @@index([revokedAt])
}
